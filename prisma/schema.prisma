// motorflow — Prisma Schema MVP
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Dealership {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  // Ícono del sitio (favicon). Separado del logo: el logo suele ser horizontal y
  // se ve mal a 32x32. Si es null, el tenant layout cae al logo como favicon.
  favicon     String?
  // Mensaje del cartel superior (announcement bar). Lo muestran los templates que
  // lo soportan (ej: "impacto"). Si es null/vacío, no se renderiza la barra.
  announcement String?
  phone       String?
  email       String?
  whatsapp    String?
  // Mensaje pre-cargado para el botón flotante de WhatsApp del sitio público.
  // Null = usa el copy default ("Hola! Me gustaría consultar..."). Editable
  // desde el admin solo si el plan habilita allowWhatsappFab.
  whatsappMessage      String?
  // Si true, muestra el FAB de WhatsApp en el sitio público. Requiere también
  // que el plan habilite allowWhatsappFab — defense in depth.
  whatsappFabEnabled   Boolean  @default(false)
  address     String?
  // Si false, la dirección (calle) NO se muestra en el sitio público — el dealer
  // igual la carga (ML necesita ubicación), pero elige no publicarla. Ciudad y
  // provincia se siguen mostrando. Default true = comportamiento histórico.
  showAddress Boolean  @default(true)
  city        String?
  province    String?
  // Ubicación geo del concesionario para el mapa del sitio público. Las coords
  // se resuelven en el dashboard vía un buscador con geocoding (OSM/Photon) — el
  // dealer NUNCA carga lat/lng a mano. mapLabel guarda la dirección formateada que
  // eligió (caption del mapa). La VISIBILIDAD del mapa la controla el toggle
  // `showMap` del config de la sección Contacto (no un flag a nivel dealership).
  latitude    Float?
  longitude   Float?
  mapLabel    String?
  // Links a redes sociales del concesionario, renderizados como barra de íconos
  // en el sitio público (footer + contacto). Shape: ver SocialLinks en src/types.
  // WhatsApp NO va acá — reusa el campo `whatsapp` de arriba.
  socialLinks Json?
  website     String?  @unique // Dominio personalizado
  theme       Json?    // Configuración de colores/branding
  active      Boolean  @default(true)
  // Controla si el sitio público {slug}.motorflowapp.com responde con el catálogo
  // o con 404. Default false → el dealer tiene que activarlo manualmente desde el
  // dashboard cuando esté listo para lanzar. Distinto de `active` (que es
  // "cuenta vigente") — un dealer activo puede tener el sitio en pausa.
  siteEnabled Boolean  @default(false)
  // Plantilla visual del sitio público. Cada plantilla define un set de tokens
  // (colores, surfaces, bordes, radius) + una fuente. La fuente activa solo
  // se carga si el dealer la elige (next/font tree-shake).
  // Valores válidos: ver TENANT_TEMPLATES en src/lib/tenant-templates.ts.
  templateId  String   @default("classic")
  plan        String   @default("base") // base | media | premium | enterprise
  // Estado de la suscripción / acceso del dealership.
  //   trial     → en período de prueba (trialEndsAt define cuándo termina)
  //   active    → pagó y está vigente
  //   expired   → trial venció sin convertir a paid
  //   suspended → bloqueado manualmente por el admin (impago, fraude, etc)
  // El dashboard layout bloquea el acceso si !== trial && !== active.
  subscriptionStatus String   @default("trial") // trial | active | expired | suspended
  // Cuándo termina el período de prueba. Null = sin trial (típico cuenta paid).
  // El cron diario marca como "expired" los dealerships con trialEndsAt < now()
  // y subscriptionStatus == "trial".
  trialEndsAt        DateTime?
  // Si true, users con role distinto de admin pueden ver el costo de compra
  // de los vehículos. Default false — sólo admins ven costos.
  showCostsToNonAdmins Boolean @default(false)
  // Suscripción a la plataforma: hasta qué fecha está paga. La setea el
  // super-admin al registrar un pago (ver SubscriptionPayment). Moroso = paidUntil
  // < now. Null = nunca pagó (típico trial). NO confundir con la operatoria del
  // tenant (módulos pagos/contabilidad son del concesionario, no de la suscripción).
  paidUntil            DateTime?
  // Plus en PESOS que el dealer suma a la cotización oficial del BCRA para
  // obtener SU cotización de trabajo (venta). La base es global (ver ExchangeRate);
  // este spread es por tenant y editable. El valor efectivo = base + usdSpread se
  // calcula al usarlo, NUNCA se persiste sumado. Default 0 (usa la oficial pura).
  // Float (no Decimal): es un parámetro de config, no un monto contable, y así
  // el Dealership queda 100% serializable hacia Client Components.
  usdSpread            Float   @default(0)
  // --- Internacionalización (i18n) ---
  // País del tenant (ISO 3166-1 alpha-2). Cimiento del que se derivan los
  // defaults de moneda/locale/timezone. Valores válidos: COUNTRIES en constants.ts.
  country              String   @default("AR")
  // Moneda por defecto del concesionario (ISO 4217). Define en qué moneda se
  // muestran/operan los precios salvo override por vehículo. Valores: CURRENCIES.
  currency             String   @default("ARS")
  // Locale del PANEL de administración (idioma + formato regional del dealer).
  locale               String   @default("es-AR")
  // Locale de la VIDRIERA pública (lo que ve el comprador). Puede divergir del
  // panel. Valores válidos: LOCALES en constants.ts.
  siteLocale           String   @default("es-AR")
  // Zona horaria IANA para mostrar fechas en la hora local del tenant.
  timezone             String   @default("America/Argentina/Buenos_Aires")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles          Vehicle[]
  leads             Lead[]
  users             DealershipUser[]
  invites           DealershipInvite[]
  customers         Customer[]
  sales             Sale[]
  reviews           Review[]
  financingPlans    FinancingPlan[]
  mlAccount         MercadoLibreAccount?
  mlListings        MercadoLibreListing[]
  sections          DealershipSection[]
  media             DealershipMedia[]
  quotations        Quotation[]
  quotationCounters QuotationCounter[]
  notifications     Notification[]
  vehicleExpenses   VehicleExpense[]
  subscriptionPayments SubscriptionPayment[]

  @@map("dealerships")
}

// Pago de la SUSCRIPCIÓN a la plataforma (lo que el concesionario le paga al
// dueño de motorflow por usar el SaaS). Tabla del negocio de la plataforma —
// NO es la operatoria del tenant. La carga el super-admin manualmente desde /admin.
// Cada pago extiende Dealership.paidUntil. Monto libre (lo define quien cobra).
model SubscriptionPayment {
  id                   String   @id @default(cuid())
  dealershipId         String
  amount               Decimal  @db.Decimal(12, 2)
  currency             String   @default("ARS")
  method               String?  // texto libre: efectivo | transferencia | MP | etc
  notes                String?
  // Fecha hasta la que quedó paga la cuenta DESPUÉS de este pago (snapshot histórico).
  paidUntil            DateTime
  paidAt               DateTime @default(now())
  createdByClerkUserId String   // super-admin que registró el pago
  createdAt            DateTime @default(now())

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@index([dealershipId, paidAt])
  @@map("subscription_payments")
}

// Registro histórico de aceptaciones de Términos y Condiciones / Privacidad.
// Una fila por cada vez que un usuario acepta una versión. NO tiene FK al
// Dealership a propósito: es un registro legal que debe sobrevivir a la baja
// del concesionario. Para saber si un usuario aceptó la versión vigente, se
// busca la fila con (clerkUserId, version actual).
model TermsAcceptance {
  id           String   @id @default(cuid())
  clerkUserId  String
  // Contexto opcional (denormalizado, sin FK) — el dealership desde el que aceptó.
  dealershipId String?
  version      String   // versión aceptada (ver CURRENT_LEGAL_VERSION en src/lib/legal.ts)
  acceptedAt   DateTime @default(now())

  @@index([clerkUserId, version])
  @@index([clerkUserId, acceptedAt])
  @@map("terms_acceptances")
}

// Notificaciones in-app del dashboard. Scoped por dealership (multi-tenant).
// Se generan desde eventos del negocio (nuevo lead, reseña pendiente, venta).
// La campanita del header las lista por polling y maneja el estado read/unread.
model Notification {
  id           String    @id @default(cuid())
  dealershipId String
  type         String    // lead | review | sale
  title        String
  body         String?
  // Ruta interna del dashboard para ir al recurso (ej: /dashboard/leads/xxx).
  link         String?
  // Null = sin leer. Se setea al marcar como leída.
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@index([dealershipId, createdAt])
  @@index([dealershipId, readAt])
  @@map("notifications")
}

// Secciones del sitio público del concesionario. Cada Dealership tiene N secciones
// (una por type) configurables desde el dashboard: enabled, order, copy, config.
model DealershipSection {
  id           String   @id @default(cuid())
  dealershipId String
  type         String   // hero | about | catalog | gallery | financing | reviews | contact
  enabled      Boolean  @default(true)
  order        Int
  title        String?
  subtitle     String?
  content      String?  @db.Text
  config       Json?    // Config específica del tipo de sección (ver SectionConfigByType)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@unique([dealershipId, type])
  @@index([dealershipId, order])
  @@map("dealership_sections")
}

// Medios (imágenes/videos) asociados al site builder del tenant. Reúne tanto los
// singletons (hero_image, hero_video, about_image, section_image) como los multi
// (gallery_image). Bucket público — son assets del sitio servidos al visitante.
model DealershipMedia {
  id           String   @id @default(cuid())
  dealershipId String
  sectionType  String   // hero | about | catalog | gallery | financing | reviews | contact
  purpose      String   // hero_image | hero_video | about_image | section_image | gallery_image
  url          String
  key          String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@index([dealershipId, sectionType])
  @@index([dealershipId, purpose])
  @@map("dealership_media")
}

model DealershipUser {
  id           String     @id @default(cuid())
  clerkUserId  String
  dealershipId String
  role         String     @default("admin") // admin | editor | viewer
  createdAt    DateTime   @default(now())

  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@unique([clerkUserId, dealershipId])
  @@map("dealership_users")
}

model DealershipInvite {
  id           String     @id @default(cuid())
  email        String?    // Opcional, solo para referencia si se usa link mágico
  role         String     @default("seller") // admin | seller
  token        String     @unique
  dealershipId String
  createdAt    DateTime   @default(now())
  expiresAt    DateTime   // Fecha de expiración del link

  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@index([dealershipId])
  @@map("dealership_invites")
}

model Vehicle {
  id           String    @id @default(cuid())
  dealershipId String
  title        String    // Ej: "Toyota Corolla XEI 2.0 2023"
  brand        String
  model        String
  year         Int
  price        Decimal   @db.Decimal(12, 2)
  currency     String    @default("ARS") // ARS | USD
  // Precio de costo (compra) — info sensible, gateada por role.
  // Puede estar en moneda distinta a `price` (típico: compra USD, venta ARS).
  costPrice    Decimal?  @db.Decimal(12, 2)
  costCurrency String?   // ARS | USD
  kilometers   Int?
  fuelType     String?   // nafta | diesel | gnc | electrico | hibrido
  transmission String?   // manual | automatica
  bodyType     String?   // suv | sedan | hatchback | coupe | pickup | minivan | convertible
  color        String?
  doors        Int?
  engine       String?   // Ej: "2.0L"
  vin          String?   // Vehicle Identification Number / chasis (17 chars en general)
  motorNumber  String?
  licensePlate String?   // patente — relevante para usados
  description  String?
  condition    String    @default("used") // new | used
  status       String    @default("available") // available | reserved | sold
  featured     Boolean   @default(false)
  // Stock ilimitado (típico de 0km): al vender NO se bloquea ni cambia de status
  // — la publicación queda siempre disponible y se puede vender N veces. Ver la
  // lógica en /api/ventas y el índice único parcial de Sale.
  unlimitedStock Boolean @default(false)
  publishedAt  DateTime?
  publicSlug   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  dealership   Dealership    @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  images       VehicleImage[]
  leads        Lead[]
  // Un vehículo puede tener varias Sales históricas (canceladas) + máximo UNA activa.
  // La unicidad de "sale activa por vehículo" se enforce con un partial unique index
  // en SQL (ver migración add_partial_unique_active_sale).
  sales        Sale[]
  mlListing    MercadoLibreListing?
  quotations   Quotation[]
  expenses     VehicleExpense[]

  @@unique([dealershipId, publicSlug])
  @@index([dealershipId, status])
  @@index([brand, model, year])
  // Orden por defecto del listado del panel (createdAt desc). Sin este índice,
  // Postgres escanea todos los vehículos del dealer y los ordena en memoria en
  // CADA carga de la pantalla y de cada página.
  @@index([dealershipId, createdAt])
  // Filtro "Solo publicados / Solo borradores" del listado, y las queries del
  // sitio público, que siempre acotan por publishedAt.
  @@index([dealershipId, publishedAt])
  @@map("vehicles")
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  url       String  // URL pública para servir la imagen
  key       String  // Key interno del storage provider (necesario para borrar)
  alt       String?
  order     Int     @default(0)
  isPrimary Boolean @default(false)

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

// Gasto de reacondicionamiento de un vehículo (pulido, mecánica, transferencia,
// gestoría, flete, etc.). Se restan del margen real: precio - costo - Σ gastos.
// dealershipId denormalizado para queries rápidas por tenant (como SaleDocument).
model VehicleExpense {
  id           String   @id @default(cuid())
  dealershipId String
  vehicleId    String
  category     String   // ver VEHICLE_EXPENSE_CATEGORIES en src/lib/constants.ts
  description  String?
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("ARS") // ARS | USD
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  vehicle    Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([dealershipId])
  @@map("vehicle_expenses")
}

model Lead {
  id           String   @id @default(cuid())
  dealershipId String
  vehicleId    String?
  name         String
  email        String?
  phone        String?
  message      String?
  source       String   @default("web") // web | whatsapp | mercadolibre | tasacion
  status       String   @default("new") // new | contacted | qualified | closed
  quoteData    Json?    // Datos del vehículo a tasar cuando source=tasacion
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dealership   Dealership  @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  quotations   Quotation[]

  @@index([dealershipId, status])
  @@map("leads")
}

// Waitlist para la landing de marketing
model WaitlistEntry {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  dealership String?  // Nombre del concesionario interesado
  phone      String?
  // Estado del lead en el funnel de invitación.
  //   pending  → solo se anotó al waitlist, todavía no aprobado
  //   invited  → admin generó token, le mando link de registro
  //   accepted → completó el sign-up + onboarding
  //   rejected → admin lo descartó (no relevant / spam)
  status     String   @default("pending") // pending | invited | accepted | rejected
  // Token único para el link de registro. Único y opaco (UUID-ish).
  // Se genera cuando el admin aprueba el lead.
  inviteToken          String?  @unique
  // Cuándo se generó el token. Para auditoría y para calcular expiración.
  invitedAt            DateTime?
  // Vencimiento del token (default: 7 días después de generarlo).
  // Si pasó, el link de /registro?token=xxx rechaza.
  inviteExpiresAt      DateTime?
  // Cuándo se completó el onboarding con este invite (acceptedAt = consumed).
  // El check de /registro lo usa para no permitir reusar el link.
  acceptedAt           DateTime?
  // Clerk userId del usuario que finalmente aceptó el invite.
  // Para vincular waitlist ↔ usuario real.
  clerkUserId          String?
  createdAt  DateTime @default(now())

  @@index([status])
  @@map("waitlist_entries")
}

// Cotización oficial USD/ARS publicada por el BCRA. Tabla GLOBAL (sin
// dealershipId): el dato es objetivo e igual para toda la plataforma. Una fila
// por día hábil. El cron diario hace upsert por (currency, date). El "plus" de
// cada concesionario vive en Dealership.usdSpread y se suma al usar, no acá.
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @default("USD") // moneda extranjera; ARS es la base implícita
  rate      Decimal  @db.Decimal(12, 4) // tipoCotizacion de referencia del BCRA
  source    String   @default("bcra")
  date      DateTime @db.Date // día del dato publicado por el BCRA
  fetchedAt DateTime @default(now())

  @@unique([currency, date])
  @@index([currency, date])
  @@map("exchange_rates")
}

// Cliente del concesionario (entidad distinta de Lead).
// Un Lead es una consulta pre-venta. Un Customer es quien firma una operación.
model Customer {
  id             String   @id @default(cuid())
  dealershipId   String
  type           String   @default("individual") // individual | company
  documentType   String   // DNI | CUIT | CUIL | PASAPORTE
  documentNumber String
  firstName      String   // Si type=company, contacto principal
  lastName       String?
  businessName   String?  // Razón social — solo si type=company
  email          String?
  phone          String?
  address        String?
  city           String?
  province       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dealership     Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  sales          Sale[]

  @@unique([dealershipId, documentType, documentNumber])
  @@index([dealershipId])
  @@map("customers")
}

// Operación de venta. Un vehículo solo puede tener UNA venta activa a la vez.
// Si se cancela queda como cancelled con motivo y libera el vehículo — desde ese
// momento se puede crear una nueva venta con el mismo vehicleId.
//
// La unicidad sobre (vehicleId) NO es un @unique total — está implementada como
// partial unique index en SQL: UNIQUE WHERE status != 'cancelled'. Prisma no
// soporta partial unique declarativo, ver migración add_partial_unique_active_sale.
model Sale {
  id            String    @id @default(cuid())
  dealershipId  String
  vehicleId     String
  customerId    String
  status        String    @default("draft") // draft | reserved | in_progress | completed | cancelled
  salePrice     Decimal   @db.Decimal(12, 2)
  currency      String    @default("ARS")
  depositAmount Decimal?  @db.Decimal(12, 2)
  depositDate   DateTime?
  invoiceNumber String?   // se completa al emitir factura (mock AFIP por ahora)
  invoiceDate   DateTime?
  deliveryDate  DateTime?
  cancelReason  String?
  notes         String?
  // Denormalizado desde Vehicle.unlimitedStock al crear la venta. Necesario para:
  // 1) el índice único parcial (excluye ventas de stock ilimitado — permite varias
  //    activas por vehículo), 2) findBlockingSale (no bloquean edición), 3) el sync
  //    de status del vehículo (las ilimitadas no lo tocan).
  unlimitedStock Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  dealership    Dealership     @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  documents     SaleDocument[]

  @@index([dealershipId, status])
  @@index([customerId])
  @@map("sales")
}

// Documento del legajo de venta. Categorizado para agrupar en la UI.
// El type es texto libre por ahora (DNI, F08, Boleto, etc) — se cerrará cuando se estabilice.
model SaleDocument {
  id           String    @id @default(cuid())
  dealershipId String    // denormalizado para queries rápidas por tenant
  saleId       String
  category     String    // customer | vehicle | operation
  type         String    // texto libre — ej: "DNI Frente", "Título", "Boleto de reserva"
  url          String    // URL pública del archivo
  key          String    // Key interno del storage provider
  fileName     String    // nombre original del archivo subido
  mimeType     String
  sizeBytes    Int
  notes        String?   // notas opcionales sobre el documento
  issuedAt     DateTime?
  expiresAt    DateTime?
  uploadedAt   DateTime  @default(now())
  uploadedBy   String    // clerkUserId

  sale         Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([dealershipId])
  @@map("sale_documents")
}

// Reseñas/Testimonios públicos de los clientes
model Review {
  id           String     @id @default(cuid())
  dealershipId String
  name         String     // Nombre del cliente
  content      String     // Opinión
  rating       Int        @default(5)
  status       String     @default("pending") // pending | approved | rejected
  createdAt    DateTime   @default(now())

  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  
  @@index([dealershipId, status])
  @@map("reviews")
}

// Módulo de Financiación — Banners y Videos administrables
model FinancingPlan {
  id           String     @id @default(cuid())
  dealershipId String
  title        String
  description  String?
  assetType    String     // image | video | youtube
  assetUrl     String
  order        Int        @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@index([dealershipId, active])
  @@map("financing_plans")
}

// ─── Integración Mercado Libre ───────────────────────────────────────────────

// Cuenta ML vinculada a un concesionario (1-a-1).
// Los tokens se almacenan encriptados con AES-256 (ver src/lib/mercadolibre/crypto.ts).
model MercadoLibreAccount {
  id           String    @id @default(cuid())
  dealershipId String    @unique
  mlUserId     String               // user_id retornado por ML
  nickname     String?              // nickname del vendedor (display)
  // Tokens encriptados — NO guardar en texto plano.
  accessToken  String
  refreshToken String
  expiresAt    DateTime             // vencimiento del access_token
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  dealership   Dealership          @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  listings     MercadoLibreListing[]

  @@map("ml_accounts")
}

// Publicación activa/histórica de un vehículo en ML.
// Un vehículo puede tener solo 1 listing activo (unique vehicleId).
model MercadoLibreListing {
  id            String    @id @default(cuid())
  dealershipId  String
  vehicleId     String    @unique  // 1 publicación activa por vehículo
  mlAccountId   String
  mlItemId      String             // ej: "MLA12345678"
  status        String    @default("active") // active | paused | closed | error
  listingTypeId String    @default("silver")
  permalink     String?            // URL pública en ML
  lastSyncedAt  DateTime?
  errorMessage  String?            // mensaje de error de ML si status=error
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  dealership    Dealership          @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  vehicle       Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  mlAccount     MercadoLibreAccount @relation(fields: [mlAccountId], references: [id], onDelete: Cascade)

  @@index([dealershipId])
  @@map("ml_listings")
}

// ─── Cotizaciones ────────────────────────────────────────────────────────────

// Cotizaciones — comerciales (venta) y de compra (tasación). Modelo único
// con discriminator `type`. Campos type-specific en columnas nullables.
model Quotation {
  id                   String   @id @default(cuid())
  dealershipId         String
  type                 String   // "sale" | "purchase"
  number               Int      // counter atómico por (dealershipId, type)
  code                 String   // derivado: "COT-V-00001" / "COT-C-00001"
  status               String   @default("pending") // pending | accepted | rejected | expired
  currency             String   @default("ARS")     // ARS | USD
  validUntil           DateTime
  emittedAt            DateTime @default(now())
  notes                String?  @db.Text
  createdByClerkUserId String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // SALE-specific (nullable cuando type=purchase)
  vehicleId             String?
  saleClientName        String?
  saleClientDocument    String?
  saleClientEmail       String?
  saleClientPhone       String?
  saleTotalPrice        Decimal? @db.Decimal(12, 2)
  saleDownPayment       Decimal? @db.Decimal(12, 2)
  saleInstallments      Int?
  saleInstallmentAmount Decimal? @db.Decimal(12, 2)
  salePaymentMethod     String? // cash | financed | mixed
  saleSellerName        String? // vendedor del concesionario (texto libre)
  // Permuta — el comprador entrega un usado como parte de pago. Todos los
  // campos son opcionales (cotización sin permuta los deja null). La moneda
  // del usado puede ser distinta a la del total — el dealer cierra la cuenta
  // aparte según cotización USD/ARS del día; el PDF solo deja constancia.
  saleTradeInBrand      String?
  saleTradeInModel      String?
  saleTradeInYear       Int?
  saleTradeInValue      Decimal? @db.Decimal(12, 2)
  saleTradeInCurrency   String? // ARS | USD

  // PURCHASE-specific (nullable cuando type=sale)
  leadId                 String?
  purchaseSellerName     String?
  purchaseSellerDocument String?
  purchaseSellerEmail    String?
  purchaseSellerPhone    String?
  purchaseBrand          String?
  purchaseModel          String?
  purchaseYear           Int?
  purchaseVersion        String?
  purchaseKilometers     Int?
  purchaseColor          String?
  purchaseFuelType       String?
  purchaseTransmission   String?
  purchaseCondition      String?
  purchaseOfferAmount    Decimal? @db.Decimal(12, 2)
  purchasePaymentMethod  String? // cash | financed | mixed

  dealership Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  // SetNull (igual que Lead.vehicle): borrar el vehículo NO destruye la cotización
  // — queda como histórico con vehicleId=null. La UI ya maneja el caso "sin vehículo".
  vehicle    Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  lead       Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([dealershipId, type, number])
  @@unique([dealershipId, code])
  @@index([dealershipId, type, status])
  @@index([dealershipId, createdAt])
  @@index([leadId])
  @@index([vehicleId])
  @@map("quotations")
}

// Counter atómico para numeración correlativa por dealer y tipo de cotización.
// Se incrementa dentro de una transacción al crear cada Quotation.
model QuotationCounter {
  id           String   @id @default(cuid())
  dealershipId String
  type         String   // "sale" | "purchase"
  next         Int      @default(1)
  updatedAt    DateTime @updatedAt

  dealership   Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@unique([dealershipId, type])
  @@map("quotation_counters")
}

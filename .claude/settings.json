{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Create",
      "Delete",
      "Bash(pnpm *)",
      "Bash(npx prisma *)",
      "Bash(git *)",
      "Bash(curl *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(rg -o 'font-\\(thin|extralight|light|normal|medium|semibold|bold|extrabold|black\\)' *.tsx)",
      "Bash(pnpm lint *)",
      "Bash(rg -n \"treatPendingAsSignedOut|sessionStatus|'pending'|\\\\\"pending\\\\\"|taskUrl|tasks\" node_modules/@clerk/nextjs/dist/esm/server/*.js node_modules/@clerk/nextjs/dist/esm/server/**/*.js)",
      "Bash(rg -rn \"task\" node_modules/@clerk/nextjs/dist/esm/server/)",
      "Bash(rg -rln \"sessionTasks|SessionTask|tasks\" node_modules/@clerk/backend/dist/)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo *)",
      "Bash(pnpm publish *)"
    ]
  },
  "preferences": {
    "language": "es-AR",
    "codeLanguage": "en",
    "autofix": true
  }
}
